// Karkain-Desktop runnable example: lifecycle and menus of a desktop app.
import desktop

func main() {
    let app = new_desktop_app("Editor", "2.0")
    app = add_menu(app, "File")
    app = add_menu(app, "Edit")
    app = add_menu(app, "View")
    app = launch(app)

    println(describe_desktop(app))
    println("menus=" + str(menu_count(app)))
    println("state=" + desktop_state(app))
}
